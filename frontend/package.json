{
  "name": "fitinerary-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:release": "node scripts/sync-evidence.mjs --strict && vite build && node scripts/write-host-config.mjs && node scripts/validate-release.mjs",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "node scripts/take-screenshots.mjs",
    "sync-evidence": "node scripts/sync-evidence.mjs",
    "prebuild": "node scripts/sync-evidence.mjs",
    "postbuild": "node scripts/write-host-config.mjs",
    "test:report": "vitest run --reporter=json --outputFile=test-results/vitest.json && PLAYWRIGHT_JSON_OUTPUT_FILE=test-results/playwright.json playwright test --reporter=json",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "live-smoke": "node scripts/live-smoke.mjs",
    "verify:clean-clone": "bash ../scripts/verify_clean_clone.sh"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "bootstrap": "5.3.8",
    "leaflet": "1.9.4",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "jsdom": "29.1.1",
    "lighthouse": "13.5.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
