# Copy to .env and fill in. NEVER commit .env.
# Leave LLM_API_KEY empty to run in sample mode (no LLM).
LLM_API_KEY=
LLM_MODEL=
MAX_INPUT_CHARS=2000
RATE_LIMIT_PER_MIN=30
# --- LLM (optional; leave LLM_API_KEY empty for sample mode) ---
# Model string: see the Anthropic models docs. claude-opus-5-5 is the current default Opus; cheaper options
# (e.g. claude-sonnet-5-5, claude-haiku-5-5) are your choice. Set a spending cap on your provider account.
# LLM_MODEL=claude-opus-5-5
# Optional: reach the model through a third-party gateway ("relay") instead of directly. Use the gateway's ROOT domain for the
# Anthropic protocol, https only, NO trailing /v1 (a trailing /v1 or slash is stripped with a warning; http:// is refused and the AI stays off).
# With this set, the cleaned user text and computed facts pass through that gateway to the model provider (see docs/PRIVACY.md).
# LLM_BASE_URL=https://gateway.example.com
# Effort for extraction/explanations ("low" default; empty = do not send the parameter)
LLM_EFFORT=low

# --- API hardening (Phase 6): all optional, safe defaults shown ---
# Exact frontend origin(s), comma separated. "*" is refused at startup. Default = localhost dev origins only.
ALLOWED_ORIGINS=http://localhost:5173
# Number of trusted reverse proxies in front of the app (0 = use the socket address). See docs/DEPLOY.md.
TRUSTED_PROXY_HOPS=0
# Per-IP per-minute limits: expensive (LLM) / standard / cheap
RATE_LIMIT_EXPENSIVE_PER_MIN=6
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_CHEAP_PER_MIN=120
# Global circuit breaker: LLM calls per rolling 24 h (per process; the provider spending cap is the real backstop)
LLM_DAILY_CALL_CAP=300
REQUEST_DEADLINE_SECONDS=25
BODY_MAX_BYTES=65536
# 1 = serve /docs and /openapi.json (development only)
ENABLE_DOCS=0
